# Copy to .env and fill in. .env is gitignored -- keep it out of the repo.
#
# Generate the key with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
#
# This signs Flask session cookies. The container refuses to start if it is
# missing or still the development default.
SECRET_KEY=

# Optional -- see the "Public holidays" section of the README.
#HOLIDAY_COUNTRY=RU
#HOLIDAY_SYNC=on
#HOLIDAY_TIMEOUT=5
